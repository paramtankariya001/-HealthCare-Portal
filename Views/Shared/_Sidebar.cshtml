@{ var patient = ViewData["Patient"] as HealthCare_Portal.Models.Patient; var displayName = patient is null ? "" : $"{patient.FirstName} {patient.LastName}".Trim(); var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant(); var unread = Convert.ToInt32(ViewData["UnreadNotifications"] ?? 0); }
<aside class="dashboard-sidebar"><div class="patient-mini"><span class="patient-avatar">@initials</span><div><strong>@displayName</strong><small>Patient ID: @(patient?.PatientCode ?? "")</small></div></div><nav class="dashboard-nav" aria-label="Patient portal navigation"><a class="active" href="/Patient/Dashboard"><i class="bi bi-grid-1x2"></i> Overview</a><a href="/Patient/Appointments"><i class="bi bi-calendar2-week"></i> Appointments</a><a href="/Patient/MedicalHistory"><i class="bi bi-journal-medical"></i> Medical history</a><a href="/Patient/Prescriptions"><i class="bi bi-capsule"></i> Prescriptions</a><a href="/Patient/Bills"><i class="bi bi-receipt"></i> Billing &amp; invoices</a><a href="/Patient/Notifications"><i class="bi bi-bell"></i> Notifications<span class="nav-count unread" style="@(unread > 0 ? "" : "display:none")">@unread</span></a></nav><div class="sidebar-help"><i class="bi bi-headset"></i><strong>Need help?</strong><small>Our care team is one call away.</small><a href="/#contact">Contact support <i class="bi bi-arrow-right"></i></a></div></aside>
