@using HealthCare_Portal.Models
@{ var notifications = ViewData["Notifications"] as IEnumerable<Notification> ?? Array.Empty<Notification>(); }
@if (notifications.Any()) { <div class="notification-list">@foreach (var n in notifications.Take(3)) { <div class="notification-item @(!n.IsRead ? "unread" : "")"><span class="activity-icon @(!n.IsRead ? "mint" : "peach")"><i class="bi bi-bell"></i></span><div><strong>@n.Title</strong><p>@n.Message</p><time>@n.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</time></div></div> }</div> } else { <div class="text-center py-4 text-muted"><i class="bi bi-bell-slash fs-2 d-block mb-2"></i><p class="mb-0">No recent activity.</p></div> }
