@model HealthCare_Portal.ViewModels.AppointmentBookingViewModel
@{
    ViewData["Title"] = "Front desk appointment booking";
    var patientId = ViewData["PatientId"] as int?;
}

<section class="role-page dashboard-page">
    <div class="container-xl">
        <partial name="_Breadcrumb" />
        <div class="portal-heading">
            <div>
                <span class="eyebrow">Front desk workflow</span>
                <h2>Book clinic appointment</h2>
                <p>Schedule an appointment on behalf of an incoming or calling patient.</p>
            </div>
            <a class="btn btn-outline-secondary" href="/Receptionist/Patients"><i class="bi bi-people"></i> Search patients</a>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="patient-dashboard">
            <aside class="dashboard-sidebar">
                <nav class="dashboard-nav" aria-label="Receptionist navigation">
                    <a href="/Receptionist/Dashboard"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                    <a href="/Receptionist/PatientRegistration"><i class="bi bi-person-plus"></i> Register patient</a>
                    <a href="/Receptionist/Patients"><i class="bi bi-people"></i> Patient list</a>
                    <a href="/Receptionist/Appointments"><i class="bi bi-calendar2-week"></i> Appointments</a>
                    <a class="active" href="/Receptionist/AppointmentBooking"><i class="bi bi-calendar-plus"></i> Book appointment</a>
                    <a href="/Receptionist/CheckIn"><i class="bi bi-person-check"></i> Check-in queue</a>
                    <a href="/Receptionist/AppointmentManagement"><i class="bi bi-kanban"></i> Queue management</a>
                </nav>
            </aside>

            <div class="dashboard-main">
                <div class="dash-panel p-4">
                    <form method="post" action="/Receptionist/AppointmentBooking" id="recBookingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DepartmentId" id="departmentIdInput" />
                        <input type="hidden" asp-for="StartTime" id="startTimeInput" />

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label" for="patientIdInput">Patient ID *</label>
                                <input type="number" name="patientId" class="form-control" id="patientIdInput" value="@patientId" placeholder="Enter Patient ID (or search in directory)" required />
                                <small class="text-muted"><a href="/Receptionist/Patients" target="_blank">Look up patient in directory <i class="bi bi-box-arrow-up-right"></i></a></small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="doctorSelect">Select Doctor *</label>
                                <select asp-for="DoctorId" class="form-select" id="doctorSelect" required>
                                    <option value="">-- Choose a doctor --</option>
                                    @foreach (var doc in Model.DoctorList)
                                    {
                                        <option value="@doc.DoctorId" data-department="@doc.DepartmentId" data-fee="@doc.ConsultationFee" selected="@(Model.DoctorId == doc.DoctorId)">
                                            Dr. @doc.FirstName @doc.LastName (@(doc.SpecializationName ?? "Specialist") - ₹@doc.ConsultationFee.ToString("N0"))
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="DoctorId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="appointmentDate">Appointment Date *</label>
                                <input asp-for="AppointmentDate" class="form-control" type="date" id="appointmentDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="reasonInput">Reason for Visit *</label>
                                <input asp-for="Reason" class="form-control" id="reasonInput" placeholder="Clinical consultation reason" required maxlength="1000" />
                                <span asp-validation-for="Reason" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Slots Section -->
                        <div class="mb-4">
                            <div class="slot-label d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label mb-0 fw-bold">Select Available Time Slot *</label>
                                <span class="small text-muted" id="slotStatusText">Select doctor and date to load slots</span>
                            </div>

                            <div class="slots" id="slotsContainer" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));gap:10px;">
                                <div class="text-muted p-3 bg-light rounded text-center w-100 col-span-full">Please choose a doctor and date to load available slots.</div>
                            </div>
                            <span asp-validation-for="StartTime" class="text-danger small mt-1 d-block" id="slotValidationError"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a class="btn btn-link text-link" href="/Receptionist/Appointments">Cancel</a>
                            <button class="btn btn-primary px-4" type="submit">
                                <i class="bi bi-calendar-check me-1"></i> Confirm Booking
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const docSelect = document.getElementById('doctorSelect');
            const dateInput = document.getElementById('appointmentDate');
            const deptInput = document.getElementById('departmentIdInput');
            const startTimeInput = document.getElementById('startTimeInput');
            const slotsContainer = document.getElementById('slotsContainer');
            const slotStatusText = document.getElementById('slotStatusText');

            function bindSlotClicks() {
                const slotButtons = slotsContainer.querySelectorAll('.slot:not(.disabled)');
                slotButtons.forEach(btn => {
                    btn.addEventListener('click', function () {
                        slotButtons.forEach(b => b.classList.remove('active'));
                        this.classList.add('active');
                        startTimeInput.value = this.getAttribute('data-start');
                        document.getElementById('slotValidationError').innerText = '';
                    });
                });
            }

            async function loadSlots() {
                const docId = docSelect.value;
                const dateVal = dateInput.value;

                if (!docId || !dateVal) {
                    slotsContainer.innerHTML = '<div class="text-muted p-3 bg-light rounded text-center w-100">Please choose a doctor and date.</div>';
                    slotStatusText.innerText = 'Select a doctor and date first';
                    return;
                }

                const selectedOpt = docSelect.selectedOptions[0];
                if (selectedOpt) {
                    const dept = selectedOpt.getAttribute('data-department');
                    if (dept) deptInput.value = dept;
                }

                slotStatusText.innerText = 'Loading available slots...';
                slotsContainer.innerHTML = '<div class="text-muted p-3 bg-light rounded text-center w-100"><span class="spinner-border spinner-border-sm me-2"></span>Loading slots...</div>';

                try {
                    const res = await fetch(`/Patient/GetAvailableSlots?doctorId=${docId}&date=${dateVal}`);
                    const slots = await res.json();

                    if (!slots || slots.length === 0) {
                        slotsContainer.innerHTML = '<div class="text-muted p-3 bg-light rounded text-center w-100">No slots available on this date. Doctor may not practice on this weekday.</div>';
                        slotStatusText.innerText = '0 slots available';
                        startTimeInput.value = '';
                        return;
                    }

                    slotStatusText.innerText = `${slots.length} slot(s) available. Click to select:`;
                    slotsContainer.innerHTML = '';
                    slots.forEach(slot => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'slot btn btn-outline-primary';
                        btn.setAttribute('data-start', slot.slotStart);
                        btn.setAttribute('data-end', slot.slotEnd);
                        btn.textContent = slot.formatted;
                        slotsContainer.appendChild(btn);
                    });
                    bindSlotClicks();
                } catch {
                    slotsContainer.innerHTML = '<div class="text-danger p-3 bg-light rounded text-center w-100">Failed to load slots.</div>';
                    slotStatusText.innerText = 'Error loading slots';
                }
            }

            docSelect.addEventListener('change', loadSlots);
            dateInput.addEventListener('change', loadSlots);
            if (docSelect.value && dateInput.value) loadSlots();

            document.getElementById('recBookingForm').addEventListener('submit', function (e) {
                if (!startTimeInput.value) {
                    e.preventDefault();
                    document.getElementById('slotValidationError').innerText = 'Please select a time slot before confirming.';
                }
            });
        });
    </script>
}
