@model HealthCare_Portal.ViewModels.RegisterPatientViewModel
@{
    ViewData["Title"] = "Patient registration";
}

<section class="role-page dashboard-page">
    <div class="container-xl">
        <partial name="_Breadcrumb" />
        <div class="portal-heading">
            <div>
                <span class="eyebrow">Front desk workflow</span>
                <h2>Patient registration</h2>
                <p>Register a new patient and create their healthcare portal account.</p>
            </div>
            <a class="btn btn-outline-secondary" href="/Receptionist/Patients"><i class="bi bi-people"></i> Patient directory</a>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                <div asp-validation-summary="All" class="mb-0"></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="patient-dashboard">
            <aside class="dashboard-sidebar">
                <nav class="dashboard-nav" aria-label="Receptionist navigation">
                    <a href="/Receptionist/Dashboard"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                    <a class="active" href="/Receptionist/PatientRegistration"><i class="bi bi-person-plus"></i> Register patient</a>
                    <a href="/Receptionist/Patients"><i class="bi bi-people"></i> Patient list</a>
                    <a href="/Receptionist/Appointments"><i class="bi bi-calendar2-week"></i> Appointments</a>
                    <a href="/Receptionist/AppointmentBooking"><i class="bi bi-calendar-plus"></i> Book appointment</a>
                    <a href="/Receptionist/CheckIn"><i class="bi bi-person-check"></i> Check-in queue</a>
                    <a href="/Receptionist/AppointmentManagement"><i class="bi bi-kanban"></i> Queue management</a>
                </nav>
            </aside>

            <div class="dashboard-main">
                <div class="dash-panel p-4">
                    <form method="post" action="/Receptionist/PatientRegistration">
                        @Html.AntiForgeryToken()

                        <h4 class="h6 text-muted text-uppercase fw-bold mb-3">Personal &amp; Contact Details</h4>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="fnInput">First name *</label>
                                <input asp-for="FirstName" class="form-control" id="fnInput" placeholder="First name" required maxlength="100" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="lnInput">Last name</label>
                                <input asp-for="LastName" class="form-control" id="lnInput" placeholder="Last name" maxlength="100" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="genderSelect">Gender *</label>
                                <select asp-for="Gender" class="form-select" id="genderSelect" required>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="dobInput">Date of birth *</label>
                                <input asp-for="DOB" class="form-control" type="date" id="dobInput" required max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DOB" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="bgSelect">Blood group</label>
                                <select asp-for="BloodGroup" class="form-select" id="bgSelect">
                                    <option value="">Select blood group</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="phoneInput">Mobile / Phone *</label>
                                <input asp-for="Phone" class="form-control" id="phoneInput" placeholder="10-digit mobile number" required maxlength="20" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="emailInput">Email address</label>
                                <input asp-for="Email" class="form-control" type="email" id="emailInput" placeholder="patient@example.com" maxlength="150" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="addressInput">Residential Address</label>
                                <textarea asp-for="Address" class="form-control" rows="2" id="addressInput" placeholder="Street, City, Postal Code" maxlength="500"></textarea>
                            </div>
                        </div>

                        <h4 class="h6 text-muted text-uppercase fw-bold mt-4 mb-3">Portal Login Credentials</h4>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label" for="userInput">Username *</label>
                                <input asp-for="Username" class="form-control" id="userInput" placeholder="Choose username" required maxlength="100" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="pwdInput">Password *</label>
                                <input asp-for="Password" class="form-control" type="password" id="pwdInput" placeholder="Secure password" required />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="cpwdInput">Confirm Password *</label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" id="cpwdInput" placeholder="Re-enter password" required />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a class="btn btn-link text-link" href="/Receptionist/Patients">Cancel</a>
                            <button class="btn btn-primary px-4" type="submit">
                                <i class="bi bi-person-check me-1"></i> Register &amp; Create Patient Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
