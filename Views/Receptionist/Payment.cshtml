@model HealthCare_Portal.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Record Payment";
}

<section class="role-page dashboard-page">
    <div class="container-xl">
        <partial name="_Breadcrumb" />
        <div class="portal-heading">
            <div>
                <span class="eyebrow">Front Desk Cash Counter</span>
                <h2>Record Payment</h2>
                <p>Accept full or partial payment for patient invoice <strong>@Model.InvoiceNumber</strong>.</p>
            </div>
            <a class="btn btn-outline-secondary" href="/Receptionist/Billing">
                <i class="bi bi-arrow-left"></i> Back to Billing
            </a>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="dash-panel">
                    <div class="dash-panel-head">
                        <div>
                            <span class="eyebrow">Invoice Summary</span>
                            <h4>@Model.InvoiceNumber</h4>
                        </div>
                    </div>

                    <div class="card bg-light border-0 p-3 mt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Patient:</span>
                            <strong>@Model.PatientName</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Billed:</span>
                            <strong>₹@Model.TotalAmount.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Already Paid:</span>
                            <span class="text-success">₹@Model.PaidAmount.ToString("N2")</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fs-5">
                            <strong class="text-danger">Remaining Balance:</strong>
                            <strong class="text-danger" id="remainingBalanceDisplay">₹@Model.RemainingBalance.ToString("N2")</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="dash-panel">
                    <div class="dash-panel-head">
                        <div>
                            <span class="eyebrow">Payment Collection</span>
                            <h4>Transaction Details</h4>
                        </div>
                    </div>

                    <form asp-action="Payment" asp-controller="Receptionist" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="BillId" />
                        <input type="hidden" asp-for="InvoiceNumber" />
                        <input type="hidden" asp-for="PatientId" />
                        <input type="hidden" asp-for="TotalAmount" />
                        <input type="hidden" asp-for="PaidAmount" />
                        <input type="hidden" asp-for="RemainingBalance" />

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-bold">Payment Amount (₹) *</label>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" max="@Model.RemainingBalance" class="form-control form-control-lg" required />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                            <small class="text-muted">Enter any amount up to ₹@Model.RemainingBalance.ToString("N2") for partial or full payment.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PaymentMethod" class="form-label fw-bold">Payment Method *</label>
                            <select asp-for="PaymentMethod" class="form-select" required>
                                <option value="Cash">Cash</option>
                                <option value="Card">Debit / Credit Card</option>
                                <option value="UPI">UPI / Digital QR</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ReferenceNumber" class="form-label fw-bold">Reference / Transaction #</label>
                            <input asp-for="ReferenceNumber" class="form-control" placeholder="UPI Txn ID, Card Approval Code, or Receipt No." />
                            <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-bold">Notes / Remarks</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Front desk cashier notes"></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Receptionist/Billing" class="btn btn-light">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle"></i> Confirm &amp; Save Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
