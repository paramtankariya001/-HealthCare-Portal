@model IReadOnlyList<HealthCare_Portal.Models.Appointment>
@{
    ViewData["Title"] = "Appointment management";
    var selectedDate = ViewData["SelectedDate"] as DateTime? ?? DateTime.Today;
}

<section class="role-page dashboard-page">
    <div class="container-xl">
        <partial name="_Breadcrumb" />
        <div class="portal-heading">
            <div>
                <span class="eyebrow">Front desk workflow</span>
                <h2>Appointment queue management</h2>
                <p>Manage patient arrivals, status changes, and room assignments.</p>
            </div>
            <a class="btn btn-primary" href="/Receptionist/CheckIn"><i class="bi bi-person-check"></i> Live check-in</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="patient-dashboard">
            <aside class="dashboard-sidebar">
                <nav class="dashboard-nav" aria-label="Receptionist navigation">
                    <a href="/Receptionist/Dashboard"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                    <a href="/Receptionist/PatientRegistration"><i class="bi bi-person-plus"></i> Register patient</a>
                    <a href="/Receptionist/Patients"><i class="bi bi-people"></i> Patient list</a>
                    <a href="/Receptionist/Appointments"><i class="bi bi-calendar2-week"></i> Appointments</a>
                    <a href="/Receptionist/AppointmentBooking"><i class="bi bi-calendar-plus"></i> Book appointment</a>
                    <a href="/Receptionist/CheckIn"><i class="bi bi-person-check"></i> Check-in queue</a>
                    <a class="active" href="/Receptionist/AppointmentManagement"><i class="bi bi-kanban"></i> Queue management</a>
                </nav>
            </aside>

            <div class="dashboard-main">
                <form method="get" action="/Receptionist/AppointmentManagement" class="filter-bar mb-3">
                    <label class="form-label mb-0 align-self-center fw-bold me-2">Date:</label>
                    <input class="form-control" name="date" type="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                    <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> Show</button>
                </form>

                <div class="table-shell">
                    <table class="staff-table admin-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Update Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No appointments for @selectedDate.ToString("dd MMM yyyy").</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var a in Model)
                                {
                                    var statusClass = a.AppointmentStatus.ToLowerInvariant().Replace(" ", "-");
                                    <tr>
                                        <td><strong>@a.AppointmentCode</strong></td>
                                        <td>@a.PatientName</td>
                                        <td>@a.DoctorName</td>
                                        <td>@DateTime.Today.Add(a.StartTime).ToString("hh:mm tt")</td>
                                        <td><span class="status-badge @statusClass">@a.AppointmentStatus</span></td>
                                        <td>
                                            @if (a.AppointmentStatus != "Cancelled" && a.AppointmentStatus != "Completed")
                                            {
                                                <div class="d-flex align-items-center gap-1">
                                                    @if (a.AppointmentStatus == "Pending" || a.AppointmentStatus == "Confirmed")
                                                    {
                                                        <form method="post" action="/Receptionist/UpdateStatus" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="appointmentId" value="@a.AppointmentId" />
                                                            <input type="hidden" name="status" value="Checked-In" />
                                                            <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2" title="Mark Checked In">Check-in</button>
                                                        </form>
                                                    }
                                                    @if (a.AppointmentStatus == "Checked-In")
                                                    {
                                                        <form method="post" action="/Receptionist/UpdateStatus" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="appointmentId" value="@a.AppointmentId" />
                                                            <input type="hidden" name="status" value="In Consultation" />
                                                            <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2" title="Call patient into doctor's room">In Consultation</button>
                                                        </form>
                                                    }
                                                    <form method="post" action="/Receptionist/UpdateStatus" onsubmit="return confirm('Cancel this appointment?');" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="appointmentId" value="@a.AppointmentId" />
                                                        <input type="hidden" name="status" value="Cancelled" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Cancel Appointment">Cancel</button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model != null && Model.Count > 0)
                {
                    <div class="table-footer mt-2">
                        <span>Showing @Model.Count appointment(s)</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
