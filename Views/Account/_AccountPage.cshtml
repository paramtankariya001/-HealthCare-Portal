@model object
@{
    var registration = ViewData["Title"]?.ToString() == "Create your account";
}
<section class="dashboard-page">
    <div class="container">
        <div class="auth-modal p-4 mx-auto" style="max-width:520px">
            <span class="eyebrow">HealthCare Portal</span>
            <h2>@ViewData["Title"]</h2>
            <p class="text-muted">Secure access to your healthcare workspace.</p>
            <form asp-controller="Account" asp-action="@(registration ? "Register" : "Login")" method="post">
                @Html.AntiForgeryToken()
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">@successMessage</div>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                @if (registration)
                {
                    <label class="form-label" for="FirstName">First name</label>
                    <input class="form-control mb-3" id="FirstName" name="FirstName" required maxlength="100" />
                    <label class="form-label" for="LastName">Last name</label>
                    <input class="form-control mb-3" id="LastName" name="LastName" maxlength="100" />
                    <label class="form-label" for="Gender">Gender</label>
                    <select class="form-select mb-3" id="Gender" name="Gender" required><option value="">Select gender</option><option>Male</option><option>Female</option><option>Other</option></select>
                    <label class="form-label" for="DOB">Date of birth</label>
                    <input class="form-control mb-3" id="DOB" name="DOB" type="date" required />
                    <label class="form-label" for="Phone">Phone</label>
                    <input class="form-control mb-3" id="Phone" name="Phone" type="tel" required />
                    <label class="form-label" for="Username">Username</label>
                    <input class="form-control mb-3" id="Username" name="Username" required maxlength="100" />
                    <label class="form-label" for="Email">Email address</label>
                    <input class="form-control mb-3" id="Email" name="Email" type="email" placeholder="you@example.com" required />
                    <label class="form-label" for="Password">Password</label>
                    <input class="form-control mb-3" id="Password" name="Password" type="password" required minlength="8" />
                }
                else
                {
                    <label class="form-label" for="Email">Login ID or Email</label>
                    <input class="form-control mb-3" id="Email" name="Username" type="text" placeholder="admin or you@example.com" required maxlength="150" autocomplete="username" />
                    <label class="form-label" for="Password">Password</label>
                    <input class="form-control mb-3" id="Password" name="Password" type="password" required autocomplete="current-password" />
                }
                @if (registration)
                {
                    <label class="form-label" for="ConfirmPassword">Confirm password</label>
                    <input class="form-control mb-3" id="ConfirmPassword" name="ConfirmPassword" type="password" required minlength="8" />
                }
                else
                {
                    <label class="form-check small mb-3"><input class="form-check-input" name="RememberMe" type="checkbox" /> Remember me</label>
                }
                <button class="btn btn-primary w-100" type="submit">@(registration ? "Create account" : "Continue") <i class="bi bi-arrow-right"></i></button>
            </form>
            <div class="d-flex justify-content-between mt-4">
                <a class="text-link" href="/Account/@(registration ? "Login" : "Register")">@(registration ? "Sign in" : "Register")</a>
                @if (!registration) { <a class="text-link" href="/Account/ForgotPassword">Forgot password?</a> }
            </div>
        </div>
    </div>
</section>
