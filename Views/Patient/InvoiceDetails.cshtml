@model HealthCare_Portal.Models.Bill
@{
    ViewData["Title"] = $"Invoice - {Model.InvoiceNumber}";
    var badgeClass = Model.PaymentStatus switch
    {
        "Paid" => "completed",
        "Partially Paid" => "available",
        _ => "pending"
    };
}

<section class="role-page dashboard-page">
    <div class="container-xl">
        <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
            <partial name="_Breadcrumb" />
            <div class="d-flex gap-2">
                <a href="/Patient/Bills" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Bills
                </a>
                <button type="button" class="btn btn-outline-primary" onclick="window.print()">
                    <i class="bi bi-printer"></i> Print Statement
                </button>
            </div>
        </div>

        <div class="card p-5 border-0 shadow-sm invoice-container bg-white">
            <div class="row align-items-center border-bottom pb-4 mb-4">
                <div class="col-sm-6">
                    <h2 class="text-primary fw-bold mb-1"><i class="bi bi-hospital"></i> HealthCare Portal</h2>
                    <p class="text-muted small mb-0">Multi-Speciality Healthcare Center<br />100 Medical Boulevard, Metro City<br />Patient Statement &amp; Receipt</p>
                </div>
                <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                    <h3 class="fw-bold mb-1">PATIENT INVOICE</h3>
                    <div class="text-muted small mb-2"># @Model.InvoiceNumber</div>
                    <span class="status-badge @badgeClass fs-6">@Model.PaymentStatus</span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-sm-6">
                    <span class="text-muted small text-uppercase fw-bold d-block mb-1">Patient Details:</span>
                    <h5 class="fw-bold mb-1">@Model.PatientName</h5>
                    <p class="text-muted small mb-0">
                        Patient Code: <strong>@Model.PatientCode</strong><br />
                        Phone: @(string.IsNullOrWhiteSpace(Model.PatientPhone) ? "—" : Model.PatientPhone)<br />
                        Address: @(string.IsNullOrWhiteSpace(Model.PatientAddress) ? "Metro City" : Model.PatientAddress)
                    </p>
                </div>
                <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                    <span class="text-muted small text-uppercase fw-bold d-block mb-1">Billing Details:</span>
                    <p class="text-muted small mb-0">
                        Date: <strong>@Model.BillDate.ToString("dd MMMM yyyy")</strong><br />
                        Attending Doctor: <strong>@(string.IsNullOrWhiteSpace(Model.DoctorName) ? "General Hospital Staff" : Model.DoctorName)</strong><br />
                        Department: <strong>@(string.IsNullOrWhiteSpace(Model.DepartmentName) ? "General Medicine" : Model.DepartmentName)</strong>
                    </p>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 50%;">Service / Charge Item</th>
                            <th class="text-center" style="width: 15%;">Quantity</th>
                            <th class="text-end" style="width: 15%;">Unit Price</th>
                            <th class="text-end" style="width: 15%;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            int idx = 1;
                            foreach (var it in Model.Items)
                            {
                                <tr>
                                    <td>@(idx++)</td>
                                    <td>
                                        <strong>@it.ServiceName</strong>
                                        @if (!string.IsNullOrWhiteSpace(it.Description))
                                        {
                                            <div class="small text-muted">@it.Description</div>
                                        }
                                    </td>
                                    <td class="text-center">@it.Quantity</td>
                                    <td class="text-end">₹@it.UnitPrice.ToString("N2")</td>
                                    <td class="text-end fw-bold">₹@it.TotalPrice.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end mb-4">
                <div class="col-md-5">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td>Subtotal:</td>
                            <td class="text-end fw-bold">₹@Model.Subtotal.ToString("N2")</td>
                        </tr>
                        @if (Model.Discount > 0)
                        {
                            <tr class="text-success">
                                <td>Discount:</td>
                                <td class="text-end">- ₹@Model.Discount.ToString("N2")</td>
                            </tr>
                        }
                        @if (Model.Tax > 0)
                        {
                            <tr>
                                <td>Tax:</td>
                                <td class="text-end">+ ₹@Model.Tax.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="border-top fs-5">
                            <td><strong>Total Amount:</strong></td>
                            <td class="text-end text-primary"><strong>₹@Model.GrandTotal.ToString("N2")</strong></td>
                        </tr>
                        <tr class="text-success">
                            <td>Paid to Date:</td>
                            <td class="text-end fw-bold">₹@Model.PaidAmount.ToString("N2")</td>
                        </tr>
                        <tr class="border-top fs-5">
                            <td><strong>Balance Due:</strong></td>
                            <td class="text-end @(Model.BalanceAmount > 0 ? "text-danger" : "text-success")">
                                <strong>₹@Model.BalanceAmount.ToString("N2")</strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            @if (Model.Payments != null && Model.Payments.Any())
            {
                <div class="border-top pt-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-clock-history"></i> Receipts &amp; Payments Recorded</h5>
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Transaction Ref</th>
                                <th>Date</th>
                                <th>Payment Mode</th>
                                <th class="text-end">Amount Paid</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Payments)
                            {
                                <tr>
                                    <td><code>@p.TransactionCode</code></td>
                                    <td>@p.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>@p.PaymentMethod</td>
                                    <td class="text-end fw-bold text-success">₹@p.Amount.ToString("N2")</td>
                                    <td><span class="badge bg-success">@p.PaymentStatus</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="border-top pt-3 text-center text-muted small">
                <p class="mb-0">For questions regarding this statement, please contact the front desk billing team.</p>
            </div>
        </div>
    </div>
</section>

<style>
    @@media print {
        .d-print-none, .dashboard-sidebar, .top-nav, footer { display: none !important; }
        .invoice-container { box-shadow: none !important; padding: 0 !important; }
        body { background: #fff !important; }
    }
</style>
