@model HealthCare_Portal.ViewModels.PatientDashboardViewModel
@{ var dashboard = Model ?? new HealthCare_Portal.ViewModels.PatientDashboardViewModel(); var upcoming = dashboard.UpcomingAppointment; var latestRecord = dashboard.LatestMedicalRecord; var patientName = $"{dashboard.Patient.FirstName} {dashboard.Patient.LastName}".Trim(); }
<section class="role-page dashboard-page"><div class="container-xl"><partial name="_Breadcrumb" /><div class="portal-heading"><div><span class="eyebrow">Patient portal</span><h2>@ViewData["Title"]</h2><p>Welcome back, @(string.IsNullOrWhiteSpace(patientName) ? "Patient" : patientName). Your connected care plan is here.</p></div><a class="btn btn-primary" href="/Patient/BookAppointment"><i class="bi bi-calendar-plus"></i> Book appointment</a></div><div class="patient-dashboard"><partial name="_Sidebar" /><div class="dashboard-main"><div class="dashboard-stats"><div class="dash-stat"><span class="dash-icon mint"><i class="bi bi-calendar-check"></i></span><div><small>Upcoming appointments</small><strong>@dashboard.UpcomingAppointmentCount.ToString("00")</strong><a href="/Patient/Appointments">View schedule</a></div></div><div class="dash-stat"><span class="dash-icon lilac"><i class="bi bi-file-earmark-medical"></i></span><div><small>Medical records</small><strong>@dashboard.MedicalRecordCount.ToString("00")</strong><a href="/Patient/MedicalHistory">View history</a></div></div><div class="dash-stat"><span class="dash-icon peach"><i class="bi bi-capsule"></i></span><div><small>Prescriptions</small><strong>@dashboard.ActivePrescriptionCount.ToString("00")</strong><a href="/Patient/Prescriptions">View medicines</a></div></div><div class="dash-stat"><span class="dash-icon yellow"><i class="bi bi-credit-card"></i></span><div><small>Pending bills</small><strong>₹@dashboard.PendingBillBalance.ToString("N0")</strong><a href="/Patient/Bills">View billing</a></div></div></div><div class="dashboard-columns"><div class="dash-panel"><div class="dash-panel-head"><div><span class="eyebrow">Care plan</span><h3>@(upcoming?.DoctorName ?? "Upcoming care")</h3></div>@if (upcoming is not null) { <span class="status-badge confirmed">@upcoming.AppointmentStatus</span> }</div>@if (upcoming is null) { <div class="text-center py-4 text-muted"><i class="bi bi-calendar-x fs-2 d-block mb-2"></i><p class="mb-0">No upcoming appointments.</p></div> } else { <div class="next-appointment"><div class="appointment-date"><strong>@upcoming.AppointmentDate.ToString("dd")</strong><small>@upcoming.AppointmentDate.ToString("MMM")<br />@upcoming.AppointmentDate.ToString("yyyy")</small></div><div class="appointment-details"><strong>@(string.IsNullOrWhiteSpace(upcoming.ReasonForVisit) ? "Appointment" : upcoming.ReasonForVisit)</strong><span><i class="bi bi-heart-pulse"></i> @(upcoming.SpecializationName ?? upcoming.DepartmentName ?? "Healthcare")</span><span><i class="bi bi-clock"></i> @DateTime.Today.Add(upcoming.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(upcoming.EndTime).ToString("hh:mm tt")</span></div></div><div class="appointment-actions"><a class="btn btn-primary" href="/Patient/AppointmentDetails/@upcoming.AppointmentId">View details</a><a class="btn btn-light" href="/Patient/RescheduleAppointment/@upcoming.AppointmentId">Reschedule</a></div> }</div><div class="dash-panel"><div class="dash-panel-head"><div><span class="eyebrow">Stay up to date</span><h3>Recent activity</h3></div></div><partial name="_Notifications" /></div></div><div class="dash-panel lower-dash"><div class="dash-panel-head"><div><span class="eyebrow">Health records</span><h3>Clinical summary</h3></div><a class="text-link" href="/Patient/MedicalHistory">See all</a></div><div class="summary-facts"><div><small>Blood group</small><strong>@(dashboard.Patient.BloodGroup ?? "Not available")</strong></div><div><small>Last visit</small><strong>@(latestRecord?.RecordDate.ToString("dd MMM yyyy") ?? "Not available")</strong></div><div><small>Allergies</small><strong>@(string.IsNullOrWhiteSpace(dashboard.Patient.Allergies) ? "Not available" : dashboard.Patient.Allergies)</strong></div><div><small>Next follow-up</small><strong>@(dashboard.NextFollowUpDate?.ToString("dd MMM yyyy") ?? "Not scheduled")</strong></div></div></div></div></div></div></section>
