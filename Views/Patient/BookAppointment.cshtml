@model HealthCare_Portal.ViewModels.AppointmentBookingViewModel
@{
    ViewData["Title"] = "Book appointment";
}

<section class="role-page dashboard-page">
    <div class="container-xl">
        <partial name="_Breadcrumb" />
        <div class="portal-heading">
            <div>
                <span class="eyebrow">Patient portal</span>
                <h2>Book an appointment</h2>
                <p>Select your healthcare provider, pick a preferred date, and choose an available time slot.</p>
            </div>
            <a class="btn btn-outline-secondary" href="/Patient/FindDoctor"><i class="bi bi-search"></i> Find doctor</a>
        </div>

        <div class="patient-dashboard">
            <partial name="_Sidebar" />
            <div class="dashboard-main">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                        <div asp-validation-summary="All" class="mb-0"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="dash-panel p-4">
                    <form method="post" action="/Patient/BookAppointment" id="bookingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DepartmentId" id="departmentIdInput" />
                        <input type="hidden" asp-for="StartTime" id="startTimeInput" />
                        <input type="hidden" asp-for="EndTime" id="endTimeInput" />

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label" for="doctorSelect">Select Doctor *</label>
                                <select asp-for="DoctorId" class="form-select" id="doctorSelect" required>
                                    <option value="">-- Choose a doctor --</option>
                                    @foreach (var doc in Model.DoctorList)
                                    {
                                        <option value="@doc.DoctorId" data-department="@doc.DepartmentId" data-fee="@doc.ConsultationFee" data-specialization="@doc.SpecializationName" selected="@(Model.DoctorId == doc.DoctorId)">
                                            Dr. @doc.FirstName @doc.LastName (@(doc.SpecializationName ?? "Specialist") - ₹@doc.ConsultationFee.ToString("N0"))
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="DoctorId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="appointmentDate">Appointment Date *</label>
                                <input asp-for="AppointmentDate" class="form-control" type="date" id="appointmentDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Doctor Summary Banner -->
                        <div id="doctorSummaryBanner" class="p-3 mb-4 rounded bg-light border @(Model.DoctorId > 0 ? "" : "d-none")">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong id="summaryDocName">@(Model.DoctorName ?? "Selected Doctor")</strong>
                                    <span class="text-muted d-block small" id="summaryDocDept">@(Model.DepartmentName ?? "") @(!string.IsNullOrWhiteSpace(Model.SpecializationName) ? $"· {Model.SpecializationName}" : "")</span>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block">Consultation Fee</small>
                                    <strong class="text-success fs-5" id="summaryDocFee">₹@Model.ConsultationFee.ToString("N0")</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Slots Section -->
                        <div class="mb-4">
                            <div class="slot-label d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label mb-0 fw-bold">Select Available Time Slot *</label>
                                <span class="small text-muted" id="slotStatusText">
                                    @(Model.DoctorId > 0 ? "Click a slot to select" : "Select a doctor and date first")
                                </span>
                            </div>

                            <div class="slots" id="slotsContainer" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));gap:10px;">
                                @if (Model.AvailableSlots.Count > 0)
                                {
                                    @foreach (var slot in Model.AvailableSlots)
                                    {
                                        var isSelected = Model.StartTime == slot.SlotStart;
                                        <button type="button" class="slot btn btn-outline-primary @(isSelected ? "active" : "")" data-start="@slot.SlotStart.ToString(@"hh\:mm\:ss")" data-end="@slot.SlotEnd.ToString(@"hh\:mm\:ss")">
                                            @slot.FormattedSlot
                                        </button>
                                    }
                                }
                                else if (Model.DoctorId > 0)
                                {
                                    <div class="text-muted p-3 bg-light rounded text-center w-100 col-span-full">No available slots for this date. Doctors usually practice on scheduled days. Please try another date.</div>
                                }
                                else
                                {
                                    <div class="text-muted p-3 bg-light rounded text-center w-100 col-span-full">Please choose a doctor and date above to load available slots.</div>
                                }
                            </div>
                            <span asp-validation-for="StartTime" class="text-danger small mt-1 d-block" id="slotValidationError"></span>
                        </div>

                        <!-- Reason for Visit -->
                        <div class="mb-4">
                            <label class="form-label" for="reasonInput">Reason for Visit *</label>
                            <textarea asp-for="Reason" class="form-control" rows="3" id="reasonInput" placeholder="Briefly describe your symptoms or purpose of consultation (e.g. routine checkup, persistent cough, chest pain)" required maxlength="1000"></textarea>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a class="btn btn-link text-link" href="/Patient/Appointments">Cancel</a>
                            <button class="btn btn-primary px-4" type="submit" id="submitBookingBtn">
                                <i class="bi bi-calendar-check me-1"></i> Confirm &amp; Book Appointment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const docSelect = document.getElementById('doctorSelect');
            const dateInput = document.getElementById('appointmentDate');
            const deptInput = document.getElementById('departmentIdInput');
            const startTimeInput = document.getElementById('startTimeInput');
            const endTimeInput = document.getElementById('endTimeInput');
            const slotsContainer = document.getElementById('slotsContainer');
            const slotStatusText = document.getElementById('slotStatusText');
            const banner = document.getElementById('doctorSummaryBanner');
            const summaryName = document.getElementById('summaryDocName');
            const summaryDept = document.getElementById('summaryDocDept');
            const summaryFee = document.getElementById('summaryDocFee');

            function bindSlotClicks() {
                const slotButtons = slotsContainer.querySelectorAll('.slot:not(.disabled)');
                slotButtons.forEach(btn => {
                    btn.addEventListener('click', function () {
                        slotButtons.forEach(b => b.classList.remove('active'));
                        this.classList.add('active');
                        startTimeInput.value = this.getAttribute('data-start');
                        endTimeInput.value = this.getAttribute('data-end');
                        document.getElementById('slotValidationError').innerText = '';
                    });
                });
            }

            async function loadSlots() {
                const docId = docSelect.value;
                const dateVal = dateInput.value;

                if (!docId || !dateVal) {
                    slotsContainer.innerHTML = '<div class="text-muted p-3 bg-light rounded text-center w-100">Please choose a doctor and date to view available time slots.</div>';
                    slotStatusText.innerText = 'Select a doctor and date first';
                    return;
                }

                // Update summary banner
                const selectedOpt = docSelect.selectedOptions[0];
                if (selectedOpt) {
                    const dept = selectedOpt.getAttribute('data-department');
                    if (dept) deptInput.value = dept;
                    const fee = selectedOpt.getAttribute('data-fee');
                    const spec = selectedOpt.getAttribute('data-specialization');
                    summaryName.textContent = selectedOpt.text.split('(')[0].trim();
                    summaryDept.textContent = spec || 'Specialist';
                    if (fee) summaryFee.textContent = '₹' + Number(fee).toLocaleString('en-IN');
                    banner.classList.remove('d-none');
                }

                slotStatusText.innerText = 'Loading available slots...';
                slotsContainer.innerHTML = '<div class="text-muted p-3 bg-light rounded text-center w-100"><span class="spinner-border spinner-border-sm me-2"></span>Checking doctor schedule and existing bookings...</div>';

                try {
                    const res = await fetch(`/Patient/GetAvailableSlots?doctorId=${docId}&date=${dateVal}`);
                    const slots = await res.json();

                    if (!slots || slots.length === 0) {
                        slotsContainer.innerHTML = '<div class="text-muted p-3 bg-light rounded text-center w-100">No slots available on this date. Doctor may not practice on this weekday, or all slots are booked.</div>';
                        slotStatusText.innerText = '0 slots available';
                        startTimeInput.value = '';
                        endTimeInput.value = '';
                        return;
                    }

                    slotStatusText.innerText = `${slots.length} slot(s) available. Click to select:`;
                    slotsContainer.innerHTML = '';
                    slots.forEach(slot => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'slot btn btn-outline-primary';
                        btn.setAttribute('data-start', slot.slotStart);
                        btn.setAttribute('data-end', slot.slotEnd);
                        btn.textContent = slot.formatted;
                        if (startTimeInput.value === slot.slotStart) {
                            btn.classList.add('active');
                        }
                        slotsContainer.appendChild(btn);
                    });
                    bindSlotClicks();
                } catch (err) {
                    slotsContainer.innerHTML = '<div class="text-danger p-3 bg-light rounded text-center w-100">Failed to load slots. Please check your connection and try again.</div>';
                    slotStatusText.innerText = 'Error loading slots';
                }
            }

            docSelect.addEventListener('change', loadSlots);
            dateInput.addEventListener('change', loadSlots);
            bindSlotClicks();

            // Validate slot selection on form submit
            document.getElementById('bookingForm').addEventListener('submit', function (e) {
                if (!startTimeInput.value) {
                    e.preventDefault();
                    document.getElementById('slotValidationError').innerText = 'Please select an appointment time slot before submitting.';
                }
            });
        });
    </script>
}
