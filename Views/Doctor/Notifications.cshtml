@model IEnumerable<HealthCare_Portal.Models.Notification>
@{
    ViewData["Title"] = "Doctor Notifications";
}

<section class="role-page dashboard-page">
    <div class="container-xl">
        <partial name="_Breadcrumb" />
        <div class="portal-heading">
            <div>
                <span class="eyebrow">Physician Workspace</span>
                <h2>Notifications &amp; Schedule Alerts</h2>
                <p>New appointments, patient check-ins, and lab report updates.</p>
            </div>
            @if (Model != null && Model.Any(n => !n.IsRead))
            {
                <form asp-action="MarkAllNotificationsRead" asp-controller="Doctor" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-check2-all"></i> Mark All as Read
                    </button>
                </form>
            }
        </div>

        <div class="dash-panel">
            <div class="dash-panel-head">
                <div>
                    <span class="eyebrow">Inbox</span>
                    <h3>Clinical Alerts</h3>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="activity-list mt-3">
                    @foreach (var n in Model)
                    {
                        var iconClass = n.NotificationType switch
                        {
                            "Appointment" => "bi-calendar-event mint-text",
                            "Prescription" => "bi-capsule peach-text",
                            "Medical Test" => "bi-heart-pulse yellow-text",
                            _ => "bi-bell mint-text"
                        };

                        var unreadClass = !n.IsRead ? "bg-light border-start border-4 border-primary ps-3" : "";

                        <div class="activity-item p-3 mb-2 rounded @unreadClass">
                            <span class="activity-icon @(n.IsRead ? "peach" : "mint")">
                                <i class="bi @iconClass"></i>
                            </span>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <strong>@n.Title</strong>
                                    <small class="text-muted">@n.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                                </div>
                                <p class="mb-0 text-muted">@n.Message</p>
                            </div>
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkNotificationRead" asp-controller="Doctor" method="post" class="d-inline ms-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.NotificationId" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Mark as read</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bell-slash fs-1 d-block mb-3"></i>
                    <h5>No notifications found</h5>
                    <p>You have no clinical alerts at this time.</p>
                </div>
            }
        </div>
    </div>
</section>
