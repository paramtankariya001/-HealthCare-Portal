@model HealthCare_Portal.ViewModels.ReceptionistFormViewModel
@{ ViewData["Title"] = "Edit receptionist"; }
<section class="dashboard-page admin-module-page"><div class="container-xl"><partial name="_Breadcrumb" /><div class="workspace-heading"><div><span class="eyebrow">Admin portal</span><h2>Edit receptionist</h2></div><a class="btn btn-outline-secondary" href="/Admin/Receptionists">Back to receptionists</a></div>@if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger"><div asp-validation-summary="All"></div></div> }<div class="staff-panel mt-3"><form method="post" action="/Admin/Receptionists/Edit/@Model.ReceptionistId">@Html.AntiForgeryToken()<input type="hidden" asp-for="ReceptionistId" /><div class="form-grid two"><label>First name *<input asp-for="FirstName" class="form-control" /></label><label>Last name<input asp-for="LastName" class="form-control" /></label><label>Email address *<input asp-for="Email" class="form-control" type="email" /></label><label>Phone number *<input asp-for="Phone" class="form-control" /></label><label>Gender *<select asp-for="Gender" class="form-select"><option>Female</option><option>Male</option><option>Other</option></select></label><label>Joining date<input asp-for="JoiningDate" class="form-control" type="date" /></label><label>Employee code<input asp-for="EmployeeCode" class="form-control" /></label><label>Login ID<input asp-for="Username" class="form-control" /><small class="text-muted">Leave blank to keep the current login ID.</small></label></div><div class="form-actions mt-4"><button class="btn btn-primary" type="submit">Save changes</button><a class="btn btn-link text-link" href="/Admin/Receptionists">Cancel</a></div></form></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
