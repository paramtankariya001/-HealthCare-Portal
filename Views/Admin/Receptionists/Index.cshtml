@model IReadOnlyList<HealthCare_Portal.Models.Receptionist>
@{ ViewData["Title"] = "Receptionist management"; }
<section class="dashboard-page admin-module-page"><div class="container-xl"><partial name="_Breadcrumb" /><div class="workspace-heading"><div><span class="eyebrow">Admin portal</span><h2>Receptionist management</h2><p>Manage front-desk staff and their linked login accounts.</p></div><div class="action-group"><a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-arrow-left"></i> Back to Admin Dashboard</a><a class="btn btn-primary" href="/Admin/Receptionists/Create"><i class="bi bi-plus-lg"></i> Add receptionist</a></div></div>
@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success mt-2">@TempData["SuccessMessage"]</div> } @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger mt-2">@TempData["ErrorMessage"]</div> }
<div class="table-shell mt-3"><table class="staff-table admin-table"><thead><tr><th>Employee code</th><th>Name</th><th>Email</th><th>Phone</th><th>Joining date</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center py-4 text-muted">No receptionist records found.</td></tr> } else { foreach (var receptionist in Model) { <tr><td><strong>@receptionist.EmployeeCode</strong></td><td>@receptionist.FirstName @receptionist.LastName</td><td>@receptionist.Email</td><td>@receptionist.Phone</td><td>@(receptionist.JoiningDate?.ToString("dd MMM yyyy") ?? "—")</td><td>@if (receptionist.IsActive) { <span class="status-badge confirmed">Active</span> } else { <span class="status-badge cancelled">Inactive</span> }</td><td><div class="d-flex align-items-center gap-1"><a class="table-action" href="/Admin/Receptionists/Details/@receptionist.ReceptionistId">View</a><a class="table-action" href="/Admin/Receptionists/Edit/@receptionist.ReceptionistId">Edit</a>@if (receptionist.IsActive) { <form method="post" action="/Admin/Receptionists/Deactivate/@receptionist.ReceptionistId" style="display:inline;">@Html.AntiForgeryToken()<button type="submit" class="table-action text-danger" style="border:none;background:none;cursor:pointer;">Deactivate</button></form> } else { <form method="post" action="/Admin/Receptionists/Activate/@receptionist.ReceptionistId" style="display:inline;">@Html.AntiForgeryToken()<button type="submit" class="table-action primary-action" style="border:none;background:none;cursor:pointer;">Activate</button></form> }</div></td></tr> } }
</tbody></table></div><div class="table-footer"><span>Showing @Model.Count record(s)</span></div></div></section>
