@model HealthCare_Portal.Models.Receptionist
@{ ViewData["Title"] = "Receptionist details"; }
<section class="dashboard-page admin-module-page"><div class="container-xl"><partial name="_Breadcrumb" /><div class="workspace-heading"><div><span class="eyebrow">Admin portal</span><h2>@Model.FirstName @Model.LastName</h2><p>Receptionist details and account status.</p></div><div class="action-group"><a class="btn btn-outline-secondary" href="/Admin/Receptionists">Back</a><a class="btn btn-primary" href="/Admin/Receptionists/Edit/@Model.ReceptionistId">Edit</a></div></div><div class="staff-panel mt-3"><dl class="row mb-0"><dt class="col-sm-4">Employee code</dt><dd class="col-sm-8">@Model.EmployeeCode</dd><dt class="col-sm-4">Login ID</dt><dd class="col-sm-8">@Model.Username</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd><dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.Phone</dd><dt class="col-sm-4">Gender</dt><dd class="col-sm-8">@Model.Gender</dd><dt class="col-sm-4">Joining date</dt><dd class="col-sm-8">@(Model.JoiningDate?.ToString("dd MMM yyyy") ?? "—")</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd></dl></div></div></section>
