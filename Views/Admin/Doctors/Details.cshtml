@model HealthCare_Portal.Models.Doctor
@{
    ViewData["Title"] = $"Dr. {Model.FirstName} {Model.LastName}";
    var initials = (!string.IsNullOrWhiteSpace(Model.FirstName) ? Model.FirstName[..1] : "D") + (!string.IsNullOrWhiteSpace(Model.LastName) ? Model.LastName[..1] : "R");
}

<section class="dashboard-page admin-module-page">
    <div class="container-xl">
        <partial name="_Breadcrumb" />
        <div class="workspace-heading">
            <div>
                <span class="eyebrow">Admin portal</span>
                <h2>Doctor Details</h2>
                <p>Complete profile and clinical details for Dr. @Model.FirstName @Model.LastName.</p>
            </div>
            <div class="action-group">
                <a class="btn btn-primary" href="/Admin/Doctors/Edit/@Model.DoctorId"><i class="bi bi-pencil"></i> Edit doctor</a>
                <a class="btn btn-outline-secondary" href="/Admin/Doctors"><i class="bi bi-arrow-left"></i> Back to list</a>
            </div>
        </div>

        <div class="staff-panel mt-3">
            <div class="doctor-profile-head">
                <span class="profile-photo">@initials</span>
                <div>
                    <h3>Dr. @Model.FirstName @Model.LastName</h3>
                    <p>@Model.Email <span class="muted-dot"></span> @Model.DoctorCode</p>
                    @if (Model.IsActive)
                    {
                        <span class="status-badge confirmed">Active account</span>
                    }
                    else
                    {
                        <span class="status-badge cancelled">Inactive account</span>
                    }
                </div>
            </div>

            <div class="summary-facts mt-4">
                <div>
                    <small>Doctor Code</small>
                    <strong>@Model.DoctorCode</strong>
                </div>
                <div>
                    <small>Specialization</small>
                    <strong>@(Model.SpecializationName ?? "General Specialist")</strong>
                </div>
                <div>
                    <small>Department</small>
                    <strong>@(Model.DepartmentName ?? "General Medicine")</strong>
                </div>
                <div>
                    <small>Experience</small>
                    <strong>@Model.ExperienceYears years</strong>
                </div>
                <div>
                    <small>Consultation fee</small>
                    <strong>₹@Model.ConsultationFee.ToString("N0")</strong>
                </div>
                <div>
                    <small>Qualification</small>
                    <strong>@(Model.Qualification ?? "MBBS")</strong>
                </div>
                <div>
                    <small>Gender</small>
                    <strong>@Model.Gender</strong>
                </div>
                <div>
                    <small>Phone</small>
                    <strong>@Model.Phone</strong>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.AboutDoctor))
            {
                <div class="mt-4">
                    <span class="eyebrow">About doctor</span>
                    <p class="mt-2 text-muted">@Model.AboutDoctor</p>
                </div>
            }

            <div class="form-actions mt-4 pt-3 border-top">
                <a class="btn btn-primary" href="/Admin/Doctors/Edit/@Model.DoctorId"><i class="bi bi-pencil"></i> Edit profile</a>
                @if (Model.IsActive)
                {
                    <form method="post" action="/Admin/Doctors/Deactivate/@Model.DoctorId" onsubmit="return confirm('Are you sure you want to deactivate Dr. @Model.FirstName @Model.LastName?');" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-slash-circle"></i> Deactivate doctor</button>
                    </form>
                }
                else
                {
                    <form method="post" action="/Admin/Doctors/Activate/@Model.DoctorId" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success"><i class="bi bi-check2-circle"></i> Activate doctor</button>
                    </form>
                }
                <a class="btn btn-link text-link" href="/Admin/Doctors">Back to doctors</a>
            </div>
        </div>
    </div>
</section>
