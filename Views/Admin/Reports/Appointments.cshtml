@{
    ViewData["Title"] = "Appointment Summary Report";
    var reportData = ViewData["ReportData"] as IReadOnlyList<Dictionary<string, object?>> ?? Array.Empty<Dictionary<string, object?>>();
    var fromDate = (ViewData["FromDate"] as DateTime?)?.ToString("yyyy-MM-dd");
    var toDate = (ViewData["ToDate"] as DateTime?)?.ToString("yyyy-MM-dd");
    long totalCount = 0;
    foreach (var r in reportData)
    {
        totalCount += Convert.ToInt64(r["AppointmentCount"]);
    }
}

<section class="dashboard-page admin-module-page">
    <div class="container-xl">
        <partial name="_Breadcrumb" />
        <div class="workspace-heading">
            <div>
                <span class="eyebrow">Administrative Reports</span>
                <h2>Appointment Statistics</h2>
                <p>Real-time distribution of patient appointments across statuses.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin/Reports?page=Revenue" class="btn btn-outline-secondary"><i class="bi bi-graph-up"></i> Revenue Report</a>
                <a href="/Admin/Reports?page=Doctors" class="btn btn-outline-secondary"><i class="bi bi-person-badge"></i> Doctor Performance</a>
                <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
            </div>
        </div>

        <div class="card p-3 mb-4 bg-light border-0">
            <form method="get" action="/Admin/Reports" class="row g-3 align-items-end">
                <input type="hidden" name="page" value="Appointments" />
                <div class="col-md-4">
                    <label class="form-label small fw-bold">From Date</label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">To Date</label>
                    <input type="date" name="toDate" value="@toDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Apply Date Filter</button>
                </div>
            </form>
        </div>

        <div class="portal-stats admin-stats mb-4">
            <div class="portal-stat mint">
                <i class="bi bi-calendar-check"></i>
                <small>Total Appointments</small>
                <strong>@totalCount</strong>
                <span>Filtered Range</span>
            </div>
            @foreach (var r in reportData)
            {
                var status = Convert.ToString(r["AppointmentStatus"]);
                var count = Convert.ToInt64(r["AppointmentCount"]);
                var statColor = status switch
                {
                    "Completed" => "lilac",
                    "Checked-In" => "peach",
                    "Cancelled" => "yellow",
                    _ => "mint"
                };

                <div class="portal-stat @statColor">
                    <i class="bi bi-clock-history"></i>
                    <small>@status</small>
                    <strong>@count</strong>
                    <span>@(totalCount > 0 ? $"{(count * 100.0 / totalCount):F1}%" : "0%") of total</span>
                </div>
            }
        </div>

        <div class="table-shell mt-3">
            <table class="staff-table admin-table">
                <thead>
                    <tr>
                        <th>Appointment Status</th>
                        <th>Number of Appointments</th>
                        <th>Percentage</th>
                    </tr>
                </thead>
                <tbody>
                    @if (reportData.Any())
                    {
                        foreach (var r in reportData)
                        {
                            var status = Convert.ToString(r["AppointmentStatus"]);
                            var count = Convert.ToInt64(r["AppointmentCount"]);
                            var badgeClass = status switch
                            {
                                "Completed" => "completed",
                                "Checked-In" => "available",
                                "Cancelled" => "danger",
                                _ => "confirmed"
                            };

                            <tr>
                                <td><span class="status-badge @badgeClass">@status</span></td>
                                <td><strong>@count</strong></td>
                                <td>@(totalCount > 0 ? $"{(count * 100.0 / totalCount):F1}%" : "0%")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No appointments found in the selected date range.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
